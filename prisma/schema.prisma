generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Order {
  id         String      @id @default(cuid())
  name       String
  email      String
  package    String
  amount     Int
  source     String
  stripeId   String      @unique
  last4      String?
  phone      String?
  pickedUp   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  pickupLogs PickupLog[]
}

model PickupLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  action    String   // "checked" or "unchecked"
  createdAt DateTime @default(now())
}

model PosShift {
  id          String    @id @default(cuid())
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openedBy    String    @default("staff")
  closedBy    String?
  orderCount  Int?
  totalRevenue Int?
  notes       String?
}

model PosOrder {
  id           String    @id @default(cuid())
  shiftId      String?
  items        String    // JSON: [{id, name, price, qty}]
  subtotal     Int
  modifier     String?
  discount     Int
  total        Int
  tender       String    @default("card") // "card" | "cash" | "comp"
  stripeId     String?   @unique          // null for cash/comp
  last4        String?
  cashTendered Int?                       // cents given by customer (cash only)
  voided       Boolean   @default(false)
  voidedAt     DateTime?
  createdAt    DateTime  @default(now())
}
